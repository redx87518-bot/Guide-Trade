<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <drawable name="splash_background">
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_40"/>
        </shape>
    </drawable>

    <drawable name="ic_launcher_foreground">
        <layer-list>
            <item>
                <bitmap android:gravity="center" android:src="@mipmap/ic_launcher_foreground"/>
            </item>
        </layer-list>
    </drawable>

    <drawable name="ic_launcher_background">
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background"/>
        </shape>
    </drawable>
</resources>
